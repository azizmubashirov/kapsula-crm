#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

python /app/manage.py migrate
python /app/manage.py collectstatic --noinput

/usr/local/bin/gunicorn config.wsgi --bind 0.0.0.0:8080 -w 2 --threads 2 --access-logfile - --error-logfile - --log-level info --capture-output --enable-stdio-inheritance --chdir=/app --timeout 180